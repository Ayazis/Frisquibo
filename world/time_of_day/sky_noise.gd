class_name SkyNoise
extends RefCounted
## The tiling 3D noise the clouds are built from: soft Perlin layers for their shapes and coverage, and
## cellular billows that erode their edges. Generated by the engine in a thread when first used;
## fixed seeds keep every run identical.

const SHAPE_SIZE := 96
const DETAIL_SIZE := 48
const SHAPE_SEED := 11
const DETAIL_SEED := 23
## Noise frequency in cycles per texel and the octaves of each.
const SHAPE_FREQUENCY := 0.04
const SHAPE_OCTAVES := 5
const DETAIL_FREQUENCY := 0.09
const DETAIL_OCTAVES := 3


static func shape() -> NoiseTexture3D:
	var noise := FastNoiseLite.new()
	noise.noise_type = FastNoiseLite.TYPE_PERLIN
	noise.seed = SHAPE_SEED
	noise.frequency = SHAPE_FREQUENCY
	noise.fractal_type = FastNoiseLite.FRACTAL_FBM
	noise.fractal_octaves = SHAPE_OCTAVES
	return _texture(noise, SHAPE_SIZE)


static func detail() -> NoiseTexture3D:
	var noise := FastNoiseLite.new()
	noise.noise_type = FastNoiseLite.TYPE_CELLULAR
	noise.seed = DETAIL_SEED
	noise.frequency = DETAIL_FREQUENCY
	noise.cellular_return_type = FastNoiseLite.RETURN_DISTANCE
	noise.fractal_type = FastNoiseLite.FRACTAL_FBM
	noise.fractal_octaves = DETAIL_OCTAVES
	return _texture(noise, DETAIL_SIZE)


static func _texture(noise: FastNoiseLite, size: int) -> NoiseTexture3D:
	var texture := NoiseTexture3D.new()
	texture.width = size
	texture.height = size
	texture.depth = size
	texture.seamless = true
	texture.normalize = true
	texture.noise = noise
	return texture
